// firestore.rules — the real, server-enforced security boundary. Deploy with
//   firebase deploy --only firestore:rules
// (or paste into Firebase Console → Firestore Database → Rules).
//
// Unlike the client-side sign-in gate, these run on Google's servers and cannot
// be bypassed from devtools. They enforce two things:
//   1. A user only ever reads/writes their own data (users/{uid}/...).
//   2. A user can NEVER write their own entitlement fields (role, subscription
//      status, trial dates, admin grants). Those are written only by the Cloud
//      Functions in functions/index.js via the Admin SDK, which bypasses these
//      rules. That is what makes subscription state tamper-proof.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Fields that describe entitlement — never client-writable.
    function entitlementKeys() {
      return ['role', 'subscriptionStatus', 'subscriptionId', 'subscriptionExpiryMillis',
              'subscriptionUpdatedAt', 'trialStartedAt', 'trialEndsAt',
              'adminGrantUntil', 'compForever'];
    }
    function touchesEntitlement() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(entitlementKeys());
    }

    match /users/{uid} {
      allow get:  if isOwner(uid) || isAdmin();
      allow list: if isAdmin();

      // A client may create its own profile doc but may not seed any entitlement
      // field — the onUserCreate Cloud Function owns those.
      allow create: if isOwner(uid)
                    && !request.resource.data.keys().hasAny(entitlementKeys());

      // A user may update their own doc (e.g. display name) but never an
      // entitlement field. Admins change entitlements through the Cloud
      // Function, not by direct client writes, so no admin exception here.
      allow update: if isOwner(uid) && !touchesEntitlement();

      allow delete: if false;

      match /assessments/{docId} { allow read, write: if isOwner(uid); }
      match /permits/{docId}     { allow read, write: if isOwner(uid); }
      match /checklists/{docId}  { allow read, write: if isOwner(uid); }
    }

    // Written only by Cloud Functions (Admin SDK); no client access.
    match /purchaseTokens/{token} { allow read, write: if false; }
    match /adminLog/{id}          { allow read: if isAdmin(); allow write: if false; }

    // Explicit default-deny for everything else.
    match /{document=**} { allow read, write: if false; }
  }
}
